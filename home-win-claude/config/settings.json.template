{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CAVEMAN_DEFAULT_MODE": "manual"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "effortLevel": "medium",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{CLAUDE_HOME}}/agent-hooks/agent_state_hooks.py\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{CLAUDE_HOME}}/agent-hooks/agent_state_hooks.py\" rate-limit",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{CLAUDE_HOME}}/agent-hooks/agent_state_hooks.py\" subagent-contract",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{CLAUDE_HOME}}/agent-hooks/agent_state_hooks.py\" skill-route",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"{{CLAUDE_HOME}}/agent-hooks/mem0_recall.py\"",
            "timeout": 8
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "wong2-plugins": {
      "source": {
        "source": "github",
        "repo": "wong2/claude-plugins"
      }
    },
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "mem0-plugins": {
      "source": {
        "source": "github",
        "repo": "mem0ai/mem0"
      }
    }
  },
  "enabledPlugins": {
    "resumer@wong2-plugins": true,
    "caveman@caveman": true,
    "mem0@mem0-plugins": true
  },
  "pluginConfigs": {
    "mem0@mem0-plugins": {
      "options": {
        "user_id": "mem0-home-win-claude"
      }
    }
  }
}
