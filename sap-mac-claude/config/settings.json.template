  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/agent-hooks/hook_delegate_route.py",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/agent-hooks/hook_batch_guard_cc.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/agent-hooks/hook_bulk_io_guard.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/agent-hooks/hook_citation_guard.py",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "mcp__jira__create_issue",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/agent-hooks/hook_jira_classify_cc.py",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/agent-hooks/hook_caveman_report_cc.py",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/agent-hooks/hook_skill_route_cc.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "aifgp-plugin-cpit-ai-coe-global-marketplace@agent-asset-registry": true,
    "typesafe@typesafe-ai": true
  },
  "extraKnownMarketplaces": {
    "agent-asset-registry": {
      "source": {
        "source": "git",
        "url": "https://github.tools.sap/CPITAICoE/agent-asset-registry.git"
      }
    },
    "typesafe-ai": {
      "source": {
        "source": "github",
        "repo": "typesafe-ai/skills"
      }
    }
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "medium",
  "gitAttribution": false,
